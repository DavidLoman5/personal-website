---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date?: Date;
  tags?: string[];
  summary?: string;
  cover?: string;
}
const { title, date, tags = [], summary, cover } = Astro.props;

const dateStr = date
  ? date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<BaseLayout title={title} description={summary}>
  <article>
    <a href="/blog" class="back">← Back to Blog</a>
    <h1 class="title">{title}</h1>
    {dateStr && <time class="muted">{dateStr}</time>}
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }
    {
      /* 封面在首屏,是 LCP 元素 —— 不能 lazy,否則反而拖慢首次繪製 */
      cover && (
        <img
          src={cover}
          alt={title}
          class="cover"
          width="1600"
          height="900"
          decoding="async"
          fetchpriority="high"
        />
      )
    }
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    margin-top: 2rem;
  }
  .back {
    font-size: 0.9rem;
  }
  .title {
    font-size: 2.1rem;
    margin: 1rem 0 0.4rem;
  }
  .tags {
    margin-top: 0.7rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .cover {
    width: 100%;
    /* 先佔好版位,圖載入時畫面才不會跳動 */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: 1.5rem 0;
  }
  .prose {
    margin-top: 1.5rem;
  }
  .prose :global(h2) {
    margin-top: 2rem;
  }
  .prose :global(img) {
    display: block;
    margin: 1.5rem auto;
  }
</style>
