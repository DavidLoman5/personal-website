---
// blog / goals / projects 三種詳情頁共用的版型。
// 以前 goals 詳情頁整份重造了這個檔案的 markup 與 CSS,現在收成一份。
import BaseLayout from './BaseLayout.astro';
import EditButton from '../components/EditButton.astro';
import TagList from '../components/TagList.astro';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  title: string;
  date?: Date;
  tags?: string[];
  summary?: string;
  cover?: string;
  coverAlt?: string;
  /** 回上一層的連結,例如 { href: '/blog/', label: 'Blog' } */
  back: { href: string; label: string };
  /** 後台集合名稱與檔名;有給才會顯示「編輯」按鈕 */
  collection?: string;
  editEntry?: string;
  minutes?: number;
  /** 已完成的目標,標題要劃掉 */
  strike?: boolean;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}
const {
  title,
  date,
  tags = [],
  summary,
  cover,
  coverAlt,
  back,
  collection,
  editEntry,
  minutes,
  strike = false,
  prev,
  next,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  publishedTime={date}
  image={cover}
>
  <article>
    <div class="topbar">
      <a href={back.href} class="back">← 回到 {back.label}</a>
      {collection && editEntry && (
        <EditButton collection={collection} entry={editEntry} label={title} />
      )}
    </div>

    <h1 class:list={['title', { strike }]}>{title}</h1>

    <p class="meta">
      {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
      {date && minutes && <span aria-hidden="true">·</span>}
      {minutes && <span>{minutes} 分鐘讀完</span>}
    </p>

    {/* goals 詳情頁用這個插槽放期程與狀態徽章 */}
    <div class="extra-meta"><slot name="meta" /></div>

    <TagList tags={tags} />

    {
      /* 封面在首屏,是 LCP 元素 —— 不能 lazy,否則反而拖慢首次繪製。
         沒填說明文字就當純裝飾(alt=""),用標題當 alt 只會讓螢幕閱讀器把同一句唸兩次。 */
      cover && (
        <img
          src={cover}
          alt={coverAlt ?? ''}
          class="cover"
          width="1600"
          height="900"
          decoding="async"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      (prev || next) && (
        <nav class="pager" aria-label="上下篇">
          {prev ? (
            <a href={prev.href} class="pager-link">
              <span class="pager-label muted">← 上一篇</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.href} class="pager-link next">
              <span class="pager-label muted">下一篇 →</span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  article {
    margin-top: var(--space-6);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .back {
    font-size: var(--text-sm);
  }
  .title {
    font-size: var(--text-3xl);
    margin: var(--space-4) 0 var(--space-2);
  }
  .title.strike {
    text-decoration: line-through;
    color: var(--text-soft);
  }
  .meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-soft);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  /* 沒有日期/插槽內容時不要留一段空白 */
  .meta:not(:has(*)),
  .extra-meta:not(:has(*)) {
    display: none;
  }
  .cover {
    width: 100%;
    /* 先佔好版位,圖載入時畫面才不會跳動 */
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin: var(--space-5) 0;
  }
  .prose {
    margin-top: var(--space-5);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .pager-link:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    text-decoration: none;
  }
  .pager-link.next {
    text-align: right;
  }
  /* 手機上兩欄各只剩 150px 左右,中文標題會被擠成一行兩個字 —— 直接改成上下排 */
  @media (max-width: 520px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      text-align: left;
    }
  }
  .pager-label {
    font-size: var(--text-xs);
  }
  .pager-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
