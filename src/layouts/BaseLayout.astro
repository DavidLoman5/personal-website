---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 文章頁要傳 'article',分享出去才會被當成一篇文章而不是首頁 */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** 分享預覽圖(站內絕對路徑,例如 /uploads/foo.jpg);沒給就用站台預設圖 */
  image?: string;
  /** 首頁與 Projects 這種網格頁要寬一點 */
  wide?: boolean;
}
const {
  title,
  description,
  ogType = 'website',
  publishedTime,
  image,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const pageDesc = description?.trim() || SITE.description;

// Astro.site 來自 astro.config.mjs 的 site 設定
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || SITE.ogImage, Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />

    {/* 手機瀏覽器的網址列底色跟著主題走 */}
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f16" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — Blog`}
      href={new URL('/rss.xml', Astro.site)}
    />

    <ClientRouter />

    <!-- 在頁面繪製前先套用主題,避免深色模式閃爍 -->
    <script is:inline>
      (function () {
        function applyTheme() {
          // localStorage 在 Safari 無痕模式會直接拋錯,不包起來的話整段會中斷、主題完全不套用
          var saved = null;
          try {
            saved = localStorage.getItem('theme');
          } catch (e) {}
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
        }
        applyTheme();
        // 這段 inline script 在換頁時不會重跑,但 document 本身還在 ——
        // 掛一次事件就能讓每次 view transition 之後重新套用主題。
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主要內容</a>
    <Header />
    <main id="main" class:list={['container', { 'container-wide': wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
