---
// 日期那一行。卡片與詳情頁以前各自抄了一份逐字相同的
// markup 與 CSS,改一邊忘另一邊就會兩處長得不一樣,收成這個元件。
import { formatDate, isoDate } from '../lib/format';

interface Props {
  date?: Date;
}
const { date } = Astro.props;
---

<p class="meta">
  {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
</p>

<style>
  .meta {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-soft);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  /* 沒給日期時(例如目標詳情頁)不要留一段空白 */
  .meta:not(:has(*)) {
    display: none;
  }
</style>
