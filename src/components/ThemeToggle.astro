---
// 深色/淺色切換按鈕
---

<button id="theme-toggle" aria-label="切換深色/淺色模式" title="切換深色/淺色模式" aria-pressed="false">
  {/* SVG 而不是 emoji —— emoji 在各平台的字重與基線都不一樣,也吃不到 currentColor */}
  <svg class="icon icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="12" y1="2.5" x2="12" y2="5"></line>
      <line x1="12" y1="19" x2="12" y2="21.5"></line>
      <line x1="2.5" y1="12" x2="5" y2="12"></line>
      <line x1="19" y1="12" x2="21.5" y2="12"></line>
      <line x1="5.3" y1="5.3" x2="7.1" y2="7.1"></line>
      <line x1="16.9" y1="16.9" x2="18.7" y2="18.7"></line>
      <line x1="18.7" y1="5.3" x2="16.9" y2="7.1"></line>
      <line x1="7.1" y1="16.9" x2="5.3" y2="18.7"></line>
    </g>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"
      fill="currentColor"></path>
  </svg>
</button>

<style>
  #theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    /* 至少 44x44 的點擊範圍 */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    color: var(--text-soft);
    transition: color var(--transition-fast), border-color var(--transition-fast),
      background var(--transition-fast);
  }
  #theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-wash);
  }
  #theme-toggle:active {
    transform: scale(0.94);
    transition: none;
  }
  .icon {
    display: block;
  }
  .icon-moon {
    display: none;
  }
  :root[data-theme='dark'] .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .icon-moon {
    display: block;
  }
</style>

<script>
  // 主題是在 <head> 的防閃爍腳本裡決定的,這裡只負責按鈕本身。
  // 綁 astro:page-load 而不是直接執行 —— 開了 view transitions 之後按鈕元素每次換頁都會被換掉,
  // 一次性的 listener 換一頁就失效了。
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const root = document.documentElement;

    const syncPressed = () =>
      btn.setAttribute('aria-pressed', String(root.getAttribute('data-theme') === 'dark'));
    syncPressed();

    btn.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      // 同上:無痕模式寫不進去也不該讓切換失效,主題本身仍要正常換
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      syncPressed();
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
