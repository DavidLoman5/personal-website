---
// 連到後台對應項目的小按鈕 —— 省掉「先進 /admin 再自己找那一篇」的步驟。
// 網址格式就是 Decap CMS 的路由;entry 用內容檔名(不含 .md),跟 Decap 的 slug 一致。
interface Props {
  collection: string; // 後台集合名:blog / goals / projects / pages
  entry?: string; // 檔名;省略代表「新增一筆」
  label?: string; // 這顆按鈕對應的東西,只給螢幕閱讀器用
}
const { collection, entry, label } = Astro.props;

const href = entry
  ? `/admin/#/collections/${collection}/entries/${entry}`
  : `/admin/#/collections/${collection}/new`;
const action = entry ? '編輯' : '新增';
const text = entry ? `✏️ ${action}` : `＋ ${action}`;
const aria = label ? `${action}:${label}` : action;
---

<a class="edit-btn" href={href} rel="nofollow" aria-label={aria}>{text}</a>

<style>
  .edit-btn {
    display: inline-flex;
    align-items: center;
    /* 44px 的觸控目標對這顆次要按鈕太大,36px 是不誤觸的下限 */
    min-height: 36px;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
  }
  .edit-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
</style>
