---
import { SITE, NAV_LINKS } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
// 判斷目前頁面,標記 active
function isActive(href: string) {
  if (href === '/') return path === '/';
  // href 已帶結尾斜線(如 /goals/),所以 startsWith 就能同時涵蓋列表頁與其下的詳情頁
  return path.startsWith(href);
}
---

<header id="site-header">
  <div class="container container-wide inner">
    <a href="/" class="brand">{SITE.title}</a>
    <div class="actions">
      <nav id="site-nav" aria-label="主導覽">
        {/* class 用 undefined 而不是空字串,沒選中的連結才不會留下一個沒用的 class="" */}
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class={isActive(link.href) ? 'active' : undefined}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      {/* 主題鈕刻意留在收合選單外面 —— 手機上切換主題仍然是一鍵可及 */}
      <ThemeToggle />
      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="選單"
      >
        <svg class="icon icon-menu" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3.5" y1="7" x2="20.5" y2="7"></line>
            <line x1="3.5" y1="12" x2="20.5" y2="12"></line>
            <line x1="3.5" y1="17" x2="20.5" y2="17"></line>
          </g>
        </svg>
        <svg class="icon icon-close" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="5.5" y1="5.5" x2="18.5" y2="18.5"></line>
            <line x1="18.5" y1="5.5" x2="5.5" y2="18.5"></line>
          </g>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
    /* 半透明毛玻璃 —— 內容從底下捲過去時才有層次 */
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px) saturate(1.6);
    -webkit-backdrop-filter: blur(12px) saturate(1.6);
  }
  /* 不支援毛玻璃(或 color-mix)的瀏覽器要退回不透明,否則文字會直接疊在內容上 */
  @supports not ((backdrop-filter: blur(1px)) and (background: color-mix(in srgb, red 50%, blue))) {
    header {
      background: var(--bg);
    }
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    /* 窄螢幕的下拉選單以這層為定位基準,才會對齊容器右緣而不是視窗右緣 */
    position: relative;
  }
  .brand {
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  nav a {
    position: relative;
    color: var(--text-soft);
    /* 至少 44px 的點擊範圍,避免在手機上誤觸 */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
  }
  nav a:hover {
    color: var(--text);
    background: var(--bg-soft);
    text-decoration: none;
  }
  nav a:active {
    transform: scale(0.985);
    background: var(--bg-soft);
  }
  nav a.active {
    color: var(--text);
    font-weight: 600;
  }
  /* 目前頁面的漸層底線 */
  nav a.active::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 6px;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--grad);
  }

  /* 漢堡鈕 —— 寬螢幕不存在,樣式沿用主題鈕那一套 */
  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    color: var(--text-soft);
    transition: color var(--transition-fast), border-color var(--transition-fast),
      background var(--transition-fast);
  }
  .nav-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-wash);
  }
  .nav-toggle:active {
    transform: scale(0.94);
    transition: none;
  }
  .icon {
    display: block;
  }
  .icon-close {
    display: none;
  }

  /* ── 窄螢幕:導覽收進下拉面板 ──────────────────────────────
     面板是絕對定位的,不會把 header 撐高 —— header 維持 60px,
     global.css 的 --header-h 與靠它計算的錨點 scroll-margin 才不會失準。 */
  @media (max-width: 720px) {
    .nav-toggle {
      display: inline-flex;
    }
    nav {
      /* 收起來時用 display:none,連結才會一起退出 tab 順序 */
      display: none;
      position: absolute;
      top: calc(100% + var(--space-2));
      right: 0;
      z-index: 1;
      min-width: 180px;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-2);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
    }
    header[data-nav-open] nav {
      display: flex;
    }
    header[data-nav-open] .icon-menu {
      display: none;
    }
    header[data-nav-open] .icon-close {
      display: block;
    }
    /* 直列時底線橫跨整列會太搶眼,縮成標題左側的一小截 */
    nav a.active::after {
      right: auto;
      width: 14px;
      bottom: 8px;
    }
  }
</style>

<script>
  // 窄螢幕的收合選單。開合狀態放在 <header> 的 data-nav-open 上,樣式全由 CSS 決定。
  function closeNav() {
    const header = document.getElementById('site-header');
    const btn = document.getElementById('nav-toggle');
    if (!header || !btn) return;
    header.removeAttribute('data-nav-open');
    btn.setAttribute('aria-expanded', 'false');
  }

  // 這兩個掛在 document 上,所以只在模組載入時綁一次 ——
  // 放進 setupNavToggle() 的話,每換一頁就會再疊一組上去。
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeNav();
  });
  document.addEventListener('click', (event) => {
    const header = document.getElementById('site-header');
    if (!header || !header.hasAttribute('data-nav-open')) return;
    if (!header.contains(event.target as Node)) closeNav();
  });

  // 按鈕本身每次換頁都會被換掉,所以要綁 astro:page-load(同 ThemeToggle)
  function setupNavToggle() {
    const header = document.getElementById('site-header');
    const btn = document.getElementById('nav-toggle');
    if (!header || !btn) return;

    btn.addEventListener('click', (event) => {
      // 不讓這次點擊冒泡到上面那個「點外面就關」的 listener
      event.stopPropagation();
      if (header.hasAttribute('data-nav-open')) {
        closeNav();
      } else {
        header.setAttribute('data-nav-open', '');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  document.addEventListener('astro:page-load', setupNavToggle);
</script>
