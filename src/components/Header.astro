---
import { SITE, NAV_LINKS } from '../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
// 判斷目前頁面,標記 active
function isActive(href: string) {
  if (href === '/') return path === '/';
  // href 已帶結尾斜線(如 /goals/),所以 startsWith 就能同時涵蓋列表頁與其下的詳情頁
  return path === href || path.startsWith(href);
}
---

<header>
  <div class="container inner">
    <a href="/" class="brand">{SITE.title}</a>
    <nav>
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class={isActive(link.href) ? 'active' : ''}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--text-soft);
    /* 至少 44px 的點擊範圍,避免在手機上誤觸 */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--text);
    background: var(--bg-soft);
    text-decoration: none;
  }
  nav a:active {
    transform: scale(0.985);
    background: var(--bg-soft);
  }
  nav a.active {
    color: var(--accent);
    font-weight: 600;
  }
</style>
