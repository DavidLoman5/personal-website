---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer>
  {/* 頁首頁尾一律用寬版容器,內文變窄時整個站的外框才不會跟著縮 */}
  <div class="container container-wide inner">
    <span class="muted">© {year} {SITE.author}</span>
    <span class="links">
      <a href="/tags/">Tags</a>
      {SITE.github && <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>}
      {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-9);
    padding: var(--space-5) 0;
    font-size: var(--text-sm);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .links {
    display: flex;
    gap: var(--space-4);
  }
</style>
