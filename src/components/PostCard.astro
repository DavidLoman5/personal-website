---
// 文章 / 作品的卡片
interface Props {
  href: string;
  title: string;
  date?: Date;
  summary?: string;
  tags?: string[];
}
const { href, title, date, summary, tags = [] } = Astro.props;

const dateStr = date
  ? date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<a href={href} class="card post-card">
  <h3>{title}</h3>
  {dateStr && <time class="muted date">{dateStr}</time>}
  {summary && <p class="summary">{summary}</p>}
  {
    tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => (
          <span class="tag">#{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  .post-card h3 {
    margin: 0 0 0.2rem;
    color: var(--text);
  }
  .date {
    font-size: 0.85rem;
  }
  .summary {
    margin: 0.6rem 0 0;
    color: var(--text-soft);
  }
  .tags {
    margin-top: 0.8rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
</style>
