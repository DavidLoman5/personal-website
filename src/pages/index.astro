---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EditButton from '../components/EditButton.astro';
import GoalItem from '../components/GoalItem.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { sortGoals, goalProgress } from '../lib/goals';
import { getPosts, getProjects } from '../lib/content';
import { readingTime } from '../lib/format';
// 封面那句名言 —— 存在 src/content/home.md,可以從後台改
import { frontmatter as home } from '../content/home.md';

// 後台清空欄位存的是空字串,?? 接不住 —— 用 || 才不會渲染出一對空引號
const quote = home.quote?.trim() || SITE.tagline;

const allGoals = await getCollection('goals', ({ data }) => !data.draft);
const progress = goalProgress(allGoals);
// 首頁只顯示還沒完成的,取前 4 個
const goals = sortGoals(allGoals.filter((g) => g.data.status !== 'done')).slice(0, 4);

const posts = (await getPosts()).slice(0, 2);
const projects = (await getProjects()).slice(0, 2);
---

<BaseLayout wide>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <p class="eyebrow muted">{SITE.author}</p>
    <h1 class="quote">&ldquo;{quote}&rdquo;</h1>
    <div class="cta">
      <a class="btn btn-primary" href="/goals/">看看我的目標</a>
      <a class="btn" href="/blog/">讀我的心得</a>
      <EditButton collection="pages" entry="home" label="首頁封面" />
    </div>
  </section>

  <section class="reveal">
    <div class="section-head">
      <h2>Goals</h2>
      <a href="/goals/">全部目標 →</a>
    </div>
    {
      goals.length > 0 ? (
        <>
          <p class="progress-line muted">
            已完成 <strong>{progress.done}</strong> / {progress.total} 個目標
          </p>
          <ul class="goal-list">
            {goals.map((goal) => (
              <GoalItem goal={goal} showTarget={false} />
            ))}
          </ul>
        </>
      ) : (
        <p class="muted">目前沒有進行中的目標。</p>
      )
    }
  </section>

  {
    posts.length > 0 && (
      <section class="reveal">
        <div class="section-head">
          <h2>Latest posts</h2>
          <a href="/blog/">全部文章 →</a>
        </div>
        <div class="grid">
          {posts.map((p) => (
            <PostCard
              href={`/blog/${p.id}/`}
              title={p.data.title}
              date={p.data.date}
              summary={p.data.summary}
              tags={p.data.tags}
              minutes={readingTime(p.body ?? '')}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="reveal">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects/">全部作品 →</a>
        </div>
        <div class="grid">
          {projects.map((p) => (
            <PostCard
              href={`/projects/${p.id}/`}
              title={p.data.title}
              date={p.data.date}
              summary={p.data.summary}
              tags={p.data.tags}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: var(--space-10) 0 var(--space-8);
    /* 光暈要能溢出到容器邊界外,又不能撐出橫向捲軸 */
    isolation: isolate;
  }
  /* 標題後方的漸層光暈,純 CSS,不載任何圖 */
  .glow {
    position: absolute;
    z-index: -1;
    top: -10%;
    left: -10%;
    width: 70%;
    aspect-ratio: 1;
    max-width: 520px;
    background: radial-gradient(
      circle at 30% 30%,
      var(--accent-wash),
      transparent 70%
    );
    filter: blur(20px);
    pointer-events: none;
  }
  .eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .quote {
    font-size: var(--text-4xl);
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 16em;
    /* 避免長句最後一行只剩一兩個字 */
    text-wrap: balance;
    background: var(--grad);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    /* 漸層裁字在少數瀏覽器不生效,先給一個看得見的底色當保險 */
    -webkit-text-fill-color: transparent;
  }
  /* 不支援 background-clip: text 就退回一般文字顏色,不要變成隱形 */
  @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
    .quote {
      background: none;
      color: var(--text);
      -webkit-text-fill-color: currentColor;
    }
  }
  .cta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  section {
    margin-bottom: var(--space-8);
  }
  .progress-line {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
  }
  .goal-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    align-items: start;
  }
</style>
