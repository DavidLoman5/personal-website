---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import EditButton from '../../components/EditButton.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Felix 的筆記、想法與學習紀錄。">
  <div class="page-head">
    <h1 class="page-title">Blog</h1>
    <EditButton collection="blog" label="心得" />
  </div>

  {
    posts.length > 0 ? (
      <div class="stack">
        {posts.map((p) => (
          <div class="reveal">
            <PostCard
              href={`/blog/${p.id}/`}
              title={p.data.title}
              date={p.data.date}
              summary={p.data.summary}
              tags={p.data.tags}
            />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">還沒有文章,敬請期待。</p>
    )
  }
</BaseLayout>
