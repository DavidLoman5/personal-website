---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagMap } from '../../lib/content';

const tagMap = await getTagMap();
// 篇數多的排前面,同樣多就照字面排
const tags = [...tagMap.entries()].sort(
  ([, a], [, b]) =>
    b.items.length - a.items.length || a.label.localeCompare(b.label, 'zh-Hant'),
);
---

<BaseLayout title="Tags" description="依標籤瀏覽 Felix 的文章與作品。">
  <h1 class="page-title">Tags</h1>
  <p class="page-intro">依標籤瀏覽文章與作品。</p>

  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(([slug, { label, items }]) => (
          <li>
            <a class="tag-chip" href={`/tags/${encodeURIComponent(slug)}/`}>
              <span>#{label}</span>
              <span class="count">{items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">還沒有任何標籤。</p>
    )
  }
</BaseLayout>

<style>
  .tag-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .tag-chip:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    text-decoration: none;
  }
  .count {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xs);
    color: var(--text-soft);
    background: var(--bg-soft);
    border-radius: var(--radius-full);
    padding: 0 var(--space-2);
  }
</style>
