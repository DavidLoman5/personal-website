---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditButton from '../../components/EditButton.astro';
import GoalItem from '../../components/GoalItem.astro';
import { sortGoals, goalProgress, TERM_LABEL } from '../../lib/goals';

const all = await getCollection('goals', ({ data }) => !data.draft);

// 短期/長期兩區以前是幾乎逐字複製的兩段 JSX,改成跑同一份迴圈
const sections = (['short', 'long'] as const).map((term) => ({
  term,
  label: TERM_LABEL[term],
  goals: sortGoals(all.filter((g) => g.data.term === term)),
}));

const progress = goalProgress(all);
---

<BaseLayout
  title="Goals"
  description="Felix 正在努力的短期與長期目標,以及各自的進度。"
>
  <div class="page-head">
    <h1 class="page-title">Goals</h1>
    <EditButton collection="goals" label="目標" />
  </div>
  <p class="page-intro">我正在努力的短期與長期目標,點進去看細節。</p>

  {
    all.length === 0 ? (
      <p class="muted">還沒有設定目標。</p>
    ) : (
      <>
        <div class="progress">
          <div class="progress-head">
            <span class="muted">整體進度</span>
            <span class="progress-num">
              {progress.done} / {progress.total}
            </span>
          </div>
          <div
            class="bar"
            role="progressbar"
            aria-label="目標完成度"
            aria-valuenow={progress.percent}
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <span class="fill" style={`width: ${progress.percent}%`} />
          </div>
        </div>

        {sections.map(
          (s) =>
            s.goals.length > 0 && (
              <section class="reveal">
                <h2>{s.label}</h2>
                <ul class="goals">
                  {s.goals.map((goal) => (
                    <GoalItem goal={goal} />
                  ))}
                </ul>
              </section>
            ),
        )}
      </>
    )
  }
</BaseLayout>

<style>
  .progress {
    margin-bottom: var(--space-7);
  }
  .progress-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }
  .progress-num {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .bar {
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--grad);
    border-radius: inherit;
  }

  section {
    margin-bottom: var(--space-7);
  }
  section h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-4);
  }
  .goals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
