---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditButton from '../../components/EditButton.astro';

const all = await getCollection('goals');
const statusRank = { doing: 0, todo: 1, done: 2 };
const sortFn = (a: any, b: any) =>
  statusRank[a.data.status] - statusRank[b.data.status] || a.data.order - b.data.order;

const shortGoals = all.filter((g) => g.data.term === 'short').sort(sortFn);
const longGoals = all.filter((g) => g.data.term === 'long').sort(sortFn);

const statusLabel = { todo: 'To do', doing: 'In progress', done: 'Done' };

function fmt(d?: Date) {
  return d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) : '';
}
---

<BaseLayout title="Goals">
  <div class="page-head">
    <h1 class="page-title">Goals</h1>
    <EditButton collection="goals" label="目標" />
  </div>
  <p class="page-intro">我正在努力的短期與長期目標,點進去看細節。</p>

  {
    all.length === 0 && (
      <p class="muted">還沒有設定目標,到 <code>/admin</code> 新增吧!</p>
    )
  }

  {
    shortGoals.length > 0 && (
      <section>
        <h2>Short-term</h2>
        <ul class="goals">
          {shortGoals.map((g) => (
            <li>
              <a href={`/goals/${g.id}/`} class={g.data.status === 'done' ? 'done' : ''}>
                <span class={`badge badge-${g.data.status}`}>{statusLabel[g.data.status]}</span>
                <span class="body">
                  <span class="text">{g.data.title}</span>
                  {g.data.target_date && <span class="muted target">Target: {fmt(g.data.target_date)}</span>}
                </span>
                <span class="arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    longGoals.length > 0 && (
      <section>
        <h2>Long-term</h2>
        <ul class="goals">
          {longGoals.map((g) => (
            <li>
              <a href={`/goals/${g.id}/`} class={g.data.status === 'done' ? 'done' : ''}>
                <span class={`badge badge-${g.data.status}`}>{statusLabel[g.data.status]}</span>
                <span class="body">
                  <span class="text">{g.data.title}</span>
                  {g.data.target_date && <span class="muted target">Target: {fmt(g.data.target_date)}</span>}
                </span>
                <span class="arrow">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  section {
    margin-bottom: 2.5rem;
  }
  .goals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .goals a {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: var(--text);
  }
  .goals a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .goals a.done .text {
    text-decoration: line-through;
    color: var(--text-soft);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }
  .target {
    font-size: 0.8rem;
  }
  .arrow {
    color: var(--text-soft);
    margin-top: 0.15rem;
  }
  .badge {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    color: #fff;
    margin-top: 0.15rem;
  }
  .badge-todo {
    background: #8a8f98;
  }
  .badge-doing {
    background: var(--accent);
  }
  .badge-done {
    background: #4a8f6a;
  }
</style>
