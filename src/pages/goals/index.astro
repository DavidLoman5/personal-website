---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditButton from '../../components/EditButton.astro';
import GoalItem from '../../components/GoalItem.astro';
import { TERM_LABEL } from '../../lib/goals';
import { getGoals } from '../../lib/content';

// getGoals() 已經做完 draft 過濾與排序,filter 不會打亂順序
const all = await getGoals();

// 短期/長期兩區以前是幾乎逐字複製的兩段 JSX,改成跑同一份迴圈
const sections = (['short', 'long'] as const).map((term) => ({
  term,
  label: TERM_LABEL[term],
  goals: all.filter((g) => g.data.term === term),
}));
---

<BaseLayout
  title="Goals"
  description="Felix 正在努力的短期與長期目標,以及各自的進度。"
>
  <div class="page-head">
    <h1 class="page-title">Goals</h1>
    <EditButton collection="goals" label="目標" />
  </div>

  {
    all.length === 0 ? (
      <p class="muted">還沒有設定目標。</p>
    ) : (
      sections.map(
        (s) =>
          s.goals.length > 0 && (
            <section class="reveal">
              <h2>{s.label}</h2>
              <ul class="goals">
                {s.goals.map((goal) => (
                  <GoalItem goal={goal} />
                ))}
              </ul>
            </section>
          ),
      )
    )
  }
</BaseLayout>

<style>
  section {
    margin-bottom: var(--space-7);
  }
  section h2 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-4);
  }
  .goals {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
