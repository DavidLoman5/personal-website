---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditButton from '../components/EditButton.astro';
import { SITE } from '../config';
import { Content, frontmatter } from '../content/about.md';
---

<BaseLayout title="關於我">
  <div class="page-head">
    <h1 class="page-title">{frontmatter.title ?? 'About'}</h1>
    <EditButton collection="pages" entry="about" label="關於我" />
  </div>

  <div class="about">
    {
      frontmatter.photo && (
        <img
          src={frontmatter.photo}
          alt={SITE.author}
          class="photo"
          width="140"
          height="140"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>
  </div>

</BaseLayout>

<style>
  .about {
    margin-top: 1rem;
    /* 照片是 float: right,原本靠下方的聯絡卡片 clear:both 收尾;
       卡片移除後改用 flow-root 自己包住浮動,免得溢出到 footer */
    display: flow-root;
  }
  .photo {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    float: right;
    margin: 0 0 1rem 1.5rem;
  }
  .prose :global(h2) {
    margin-top: 2rem;
  }
</style>
