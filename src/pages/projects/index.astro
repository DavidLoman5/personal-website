---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditButton from '../../components/EditButton.astro';
import TagList from '../../components/TagList.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Felix 做過的專案與作品。" wide>
  <div class="page-head">
    <h1 class="page-title">Projects</h1>
    <EditButton collection="projects" label="作品" />
  </div>

  {
    projects.length > 0 ? (
      <div class="grid">
        {projects.map((p, i) => (
          <article class="card project reveal">
            {p.data.cover && (
              <img
                src={p.data.cover}
                alt={p.data.cover_alt ?? ''}
                class="cover"
                width="800"
                height="450"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
            {/* .card-title 定義在 global.css:標題連結撐開整張卡的點擊範圍 */}
            <h2 class="card-title title">
              <a href={`/projects/${p.id}/`}>{p.data.title}</a>
            </h2>
            {p.data.summary && <p class="muted summary">{p.data.summary}</p>}
            <TagList tags={p.data.tags} />
            <div class="card-foot">
              {p.data.link && (
                <a href={p.data.link} target="_blank" rel="noopener" class="link">
                  外部連結 ↗
                </a>
              )}
              <EditButton collection="projects" entry={p.id} label={p.data.title} />
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="muted">還沒有作品,敬請期待。</p>
    )
  }
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }
  .project {
    display: flex;
    flex-direction: column;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
  }
  .title {
    font-size: var(--text-lg);
  }
  .summary {
    margin: var(--space-2) 0 0;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    /* 把頁尾推到卡片底部,高矮不一的卡片才對得齊 */
    margin-top: auto;
    padding-top: var(--space-4);
  }
  /* 沒有外部連結時,編輯鈕自己靠右 */
  .card-foot :global(.edit-btn:only-child) {
    margin-left: auto;
  }
  .link {
    display: inline-block;
    font-weight: 600;
    font-size: var(--text-sm);
    /* 浮在整張卡的覆蓋層之上,才點得到自己 */
    position: relative;
    z-index: 1;
  }
</style>
